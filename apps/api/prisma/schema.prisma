// BOSSONE.LK - application database schema.
//
// RULES FOR THE TEAM
// - Prisma Migrate is the ONLY tool that changes this schema. Do not create tables in Supabase Studio.
// - SQL that Prisma cannot express (RLS policies, storage policies, Realtime triggers) goes into a
//   Prisma migration as raw SQL: `pnpm --filter @bossone/api exec prisma migrate dev --create-only`,
//   then edit the generated migration.sql before applying it.
// - Every schema change is reviewed by the whole team in a pull request.
// - Money is Decimal(12,2) in LKR. Never use Float for money.
//
// This file is the foundation (users, roles, catalogue, pricing, audit). Each member adds the
// tables for their modules (orders, inventory, payments, delivery, QC, support...) in their own
// migrations, following docs/database/README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users and roles
// ---------------------------------------------------------------------------

enum UserType {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  /// Customer deleted their account: personal data anonymised, orders and financial records kept.
  DELETED
}

/// Keep in sync with ROLES in packages/shared/src/roles.ts
enum RoleCode {
  CUSTOMER
  SERVICE_MANAGER
  STOCK_MANAGER
  QUALITY_CONTROLLER
  DELIVERER
  ACCOUNTANT
  OWNER_ADMIN
}

/// Application user. Linked to Supabase Auth (auth.users) through `authUserId`.
/// Staff records are created by the Owner/Admin BEFORE the person first signs in;
/// on first sign-in the API links the Supabase account by matching email.
model User {
  id         String     @id @default(uuid()) @db.Uuid
  authUserId String?    @unique @map("auth_user_id") @db.Uuid
  email      String?    @unique
  phone      String?    @unique
  fullName   String?    @map("full_name")
  /// Set when the phone number is confirmed with our SMS OTP (see PhoneOtp).
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  /// Set when the customer deletes the account (H22).
  deletedAt  DateTime?  @map("deleted_at")
  userType   UserType   @map("user_type")
  status     UserStatus @default(ACTIVE)
  /// Staff number shown in the Owner's Staff & Accounts list, e.g. "EMP-014". Null for customers.
  employeeCode String?  @unique @map("employee_code")
  /// Set when the Owner suspends a staff account (status DEACTIVATED).
  suspendedAt  DateTime? @map("suspended_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  roles             UserRole[]      @relation("UserRoles")
  rolesGranted      UserRole[]      @relation("RolesGrantedBy")
  productsCreated   Product[]       @relation("ProductCreatedBy")
  productsReviewed  Product[]       @relation("ProductReviewedBy")
  priceChanges      PriceHistory[]
  auditLogs         AuditLog[]

  // Section A - customer account & verification
  customerProfile       CustomerProfile?       @relation("CustomerProfileUser")
  identityReviewed      CustomerProfile[]      @relation("IdentityReviewedBy")
  salons                Salon[]                @relation("SalonOwner")
  salonsReviewed        Salon[]                @relation("SalonReviewedBy")
  addresses             Address[]
  verificationDocuments VerificationDocument[]
  verificationEvents    VerificationEvent[]    @relation("VerificationEventCustomer")
  verificationActions   VerificationEvent[]    @relation("VerificationEventActor")
  dataRequests          DataRequest[]
  phoneOtps             PhoneOtp[]
  cart                  Cart?
  wishlistItems         WishlistItem[]
  interests             CustomerInterest[]
  preferredBrands       CustomerPreferredBrand[]
  regularProducts       RegularProduct[]
  orders                Order[]                @relation("OrderCustomer")
  orderEvents           OrderEvent[]           @relation("OrderEventActor")

  // Section D - order chats and support requests
  supportThreads        SupportThread[]        @relation("ThreadCustomer")
  assignedThreads       SupportThread[]        @relation("ThreadAssignee")
  supportMessages       SupportMessage[]       @relation("MessageAuthorUser")
  notifications         Notification[]
  notificationSettings  NotificationSetting[]

  // Production readiness - delivery, cancellations, credit notes, loyalty
  cancellationRequests  CancellationRequest[]  @relation("CancellationCustomer")
  cancellationDecisions CancellationRequest[]  @relation("CancellationDecider")
  inspections           DeliveryInspection[]   @relation("InspectionCustomer")
  codCollections        CodCollection[]        @relation("CodCollector")
  creditNotes           CreditNote[]           @relation("CreditNoteCustomer")
  creditNotesIssued     CreditNote[]           @relation("CreditNoteIssuer")
  loyaltyEntries        LoyaltyEntry[]

  // Owner workspace - see the "Owner workspace" section below
  stockMovements        StockMovement[]        @relation("StockMovementActor")
  stockCountsSubmitted  StockCount[]           @relation("StockCountSubmitter")
  stockCountsDecided    StockCount[]           @relation("StockCountDecider")
  stockCountsWitnessed  StockCount[]           @relation("StockCountWitness")
  qcInspections         QcInspection[]         @relation("QcInspector")
  qcPhotos              QcPhoto[]              @relation("QcPhotoUploader")
  bannersCreated        Banner[]               @relation("BannerCreator")
  bannersPublished      Banner[]               @relation("BannerPublisher")
  bannerVersionsSubmitted BannerVersion[]      @relation("BannerVersionSubmitter")
  bannerVersionsReviewed  BannerVersion[]      @relation("BannerVersionReviewer")
  articlesCreated       HelpArticle[]          @relation("ArticleCreator")
  articleVersionsSubmitted HelpArticleVersion[] @relation("ArticleVersionSubmitter")
  articleVersionsReviewed  HelpArticleVersion[] @relation("ArticleVersionReviewer")
  articlesPublished     HelpArticleLive[]      @relation("ArticlePublisher")
  exceptionsRaised      BusinessException[]    @relation("ExceptionRaiser")
  exceptionActions      ExceptionAction[]      @relation("ExceptionActionActor")
  closingsPrepared      FinancialClosing[]     @relation("ClosingPreparer")
  closingsReviewed      FinancialClosing[]     @relation("ClosingReviewer")
  integrityCheckpoints  IntegrityCheckpoint[]
  expensesCreated       Expense[]              @relation("ExpenseCreator")
  businessGoals         BusinessGoal[]
  goalsAssigned         Goal[]                 @relation("GoalAssignee")
  goalsCreated          Goal[]                 @relation("GoalCreator")
  goalRevisions         GoalRevision[]         @relation("GoalRevisionAuthor")

  // Deliverer performance (demerit points)
  demeritRulesChanged   DemeritRule[]          @relation("DemeritRuleAuthor")
  violationsAgainst     DelivererViolation[]   @relation("ViolationDeliverer")
  violationsReported    DelivererViolation[]   @relation("ViolationReporter")
  violationsDecided     DelivererViolation[]   @relation("ViolationDecider")
  violationActions      ViolationAction[]      @relation("ViolationActionActor")
  returnsRaised         ReturnCase[]           @relation("ReturnCustomer")
  returnsDecided        ReturnCase[]           @relation("ReturnDecider")
  returnsReceived       ReturnCase[]           @relation("ReturnReceiver")
  returnsInspected      ReturnCase[]           @relation("ReturnQc")
  returnsClassified     ReturnCase[]           @relation("ReturnClassifier")
  returnsClosed         ReturnCase[]           @relation("ReturnCloser")
  returnEvents          ReturnCaseEvent[]      @relation("ReturnEventActor")
  receiptsTaken         StockReceipt[]         @relation("ReceiptOfficer")
  collectionsTaken      OrderCollection[]      @relation("CollectionOfficer")
  packingsTaken         OrderPacking[]         @relation("PackingOfficer")
  warehouseEvidence     WarehouseEvidence[]    @relation("WarehouseEvidenceAuthor")

  @@map("users")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        RoleCode
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at")

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RolesGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Keep in sync with PRODUCT_STATUSES in packages/shared/src/products.ts
enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  DISCONTINUED
}

/// Brand shown on Explore Brands and its own brand store page.
model Brand {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  slug          String    @unique
  /// Big word on the home "Featured Brands" card, e.g. "TAKARA". Defaults to the first word of name.
  wordmark      String?
  /// Gold line under the wordmark, e.g. "Professionnel Paris". Defaults to name.
  wordmarkSub   String?   @map("wordmark_sub")
  /// Short category label, e.g. "Salon Equipment".
  specialty     String?
  /// Tag on the home "Featured Brands" card, e.g. "EQUIPMENT", "BARBER".
  cardTag       String?   @map("card_tag")
  /// One line, e.g. "Hydraulic Chairs & Stations".
  tagline       String?
  description   String?
  /// Two short chips on the brand card, e.g. ["230V Certified", "Heavy Duty 250kg"].
  featureTags   String[]  @default([]) @map("feature_tags")
  /// Chips on the brand store header, e.g. ["Origin: Milan, Italy", "Standard Voltage: 230V Compliant"].
  highlights    String[]  @default([])
  /// Badges next to the brand name, e.g. ["Official Trade Partner", "Direct Italian Line"].
  partnerBadges String[]  @default([]) @map("partner_badges")
  /// Official brand logo in the public "brand-files" bucket (e.g. logos/loreal.svg). Falls back to the wordmark.
  logoPath      String?   @map("logo_path")
  /// Monogram tile colour: DARK (black), NAVY or LIGHT.
  tileStyle     String    @default("DARK") @map("tile_style")
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0) @map("sort_order")
  /// Optional PDF in the public "brand-files" bucket.
  specSheetPath String?   @map("spec_sheet_path")
  specSheetNote String?   @map("spec_sheet_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  products      Product[]
  preferredBy   CustomerPreferredBrand[]

  @@map("brands")
}

model Category {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  slug             String     @unique
  parentId         String?    @map("parent_id") @db.Uuid
  /// Customer-facing groups for the category filter chips: "Hair", "Skin & Nails", "Equipment".
  groupName        String?    @map("group_name")
  /// Material Symbols icon name, e.g. "content_cut".
  icon             String?
  /// Short line for home cards, e.g. "Shampoos, Treatments & Backbar".
  shortDescription String?    @map("short_description")
  description      String?
  /// Label on the category image, e.g. "Technical Formulations".
  badge            String?
  /// Path in the public "product-images" bucket.
  imagePath        String?    @map("image_path")
  sortOrder        Int        @default(0) @map("sort_order")
  /// Only categories marked visible reach customers. The storefront sells professional hair products only,
  /// so older catalogue categories (electricals, skin, nails, furniture) stay hidden unless the Owner shows them.
  customerVisible  Boolean    @default(false) @map("customer_visible")
  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  createdAt        DateTime   @default(now()) @map("created_at")
  products         Product[]
  interestedCustomers CustomerInterest[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  sku             String        @unique
  name            String
  description     String?
  status          ProductStatus @default(DRAFT)
  brandId         String?       @map("brand_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  rejectionReason String?       @map("rejection_reason")
  /// One-line description shown on cards.
  summary         String?
  /// Small type label on brand store cards, e.g. "Backwash", "Styling Chair".
  typeLabel       String?       @map("type_label")
  /// Short note next to the price, e.g. "Instant dispatch", "Pro Exclusive".
  dispatchNote    String?       @map("dispatch_note")
  /// Shown in "Featured Products" on the home page.
  featured        Boolean       @default(false)
  /// Summary of the active variants, kept up to date by ProductsService.refreshSummary().
  /// Used for fast price sorting/filtering. Null listPrice = not priced = hidden from customers.
  listPrice       Decimal?      @map("list_price") @db.Decimal(12, 2)
  minMoq          Int           @default(1) @map("min_moq")
  inStock         Boolean       @default(false) @map("in_stock")
  /// Owner switch to hide a product from customers while stock remains. Separate from MOQ and stock.
  customerVisible Boolean       @default(true) @map("customer_visible")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  createdBy  User             @relation("ProductCreatedBy", fields: [createdById], references: [id])
  reviewedBy User?            @relation("ProductReviewedBy", fields: [reviewedById], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  wishlistItems WishlistItem[]
  regularFor    RegularProduct[]
  orderItems    OrderItem[]

  @@index([status])
  @@index([featured])
  @@index([status, listPrice])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String   @unique
  name         String
  /// e.g. {"size": "500ml", "shade": "Natural Black"}
  attributes   Json     @default("{}")
  /// Base selling price in LKR per sale unit (one item, or one pack when unitsPerPack is set),
  /// set by the Accountant. Null = not yet priced (not sellable).
  price        Decimal? @db.Decimal(12, 2)
  /// Set when this variant is sold by the pack: how many individual units one pack contains.
  /// Price, MOQ, stock and cart quantities then count packs. Null = sold as single units.
  unitsPerPack Int?     @map("units_per_pack")
  /// Effective minimum order quantity used by the cart and checkout. 0 = no minimum (never means out
  /// of stock). Kept equal to moqOverride when set, otherwise to the default MOQ ("wholesale.defaultMoq").
  moq          Int      @default(1)
  /// Product-specific MOQ set by the Owner. Null = use the default MOQ.
  moqOverride  Int?     @map("moq_override")
  /// Allowed quantities go up in these steps from the MOQ (1 = any quantity).
  orderIncrement Int    @default(1) @map("order_increment")
  /// What one sale unit costs BOSSONE.LK (LKR), set by the Owner for profit reporting. Null = not known.
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 2)
  /// Pack label on cards, e.g. "1500ml Backbar", "10 x 12ml Box".
  packLabel    String?  @map("pack_label")
  /// Customer-facing available quantity, controlled by the Accountant (Workflow 03).
  /// Physical stock lives in the inventory module (Member 02).
  availableQty Int      @default(0) @map("available_qty")
  /// Shown when out of stock, e.g. "Next Shipment ETA: 4 Days".
  restockNote  String?  @map("restock_note")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  priceTiers   PriceTier[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  inventory      InventoryLevel?
  receiptLines   StockReceiptLine[]
  stockMovements StockMovement[]
  stockCountLines StockCountLine[]
  exceptions     BusinessException[]

  @@index([productId])
  @@map("product_variants")
}

/// Volume pricing: from `minQty` units the unit price drops to `unitPrice`.
model PriceTier {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  minQty    Int            @map("min_qty")
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  /// Optional name, e.g. "Salon Pro", "Distributor", "Case of 12".
  label     String?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@map("price_tiers")
}

/// Path in the public "product-images" Supabase Storage bucket.
model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  storagePath String   @map("storage_path")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Every price change is recorded; prices are never silently overwritten.
model PriceHistory {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedById String   @map("changed_by_id") @db.Uuid
  reason      String?
  changedAt   DateTime @default(now()) @map("changed_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy User           @relation(fields: [changedById], references: [id])

  @@index([variantId, changedAt])
  @@map("price_history")
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// Never store passwords, tokens or private document contents here.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  /// Roles the actor held when acting (empty = system action).
  actorRoles String[] @default([]) @map("actor_roles")
  /// Reason or comment given with the action, when one is required.
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Section A - customer account, salons, addresses, verification (Member 01)
// Workflow 01: register -> verify contact -> submit identity + salon -> staff review.
// ---------------------------------------------------------------------------

/// Keep in sync with VERIFICATION_STATUSES in packages/shared/src/customers.ts
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  CLARIFICATION_REQUIRED
  REJECTED
}

/// Customer-level identity details (the salon owner / authorized buyer).
model CustomerProfile {
  userId           String             @id @map("user_id") @db.Uuid
  fullLegalName    String?            @map("full_legal_name")
  /// Sri Lankan NIC: 12 digits (new) or 9 digits + V/X (old). Never returned in full to clients.
  nicNumber        String?            @map("nic_number")
  designation      String?
  deskPhone        String?            @map("desk_phone")
  identityStatus   VerificationStatus @default(NOT_SUBMITTED) @map("identity_status")
  identitySubmittedAt DateTime?       @map("identity_submitted_at")
  identityReviewedAt  DateTime?       @map("identity_reviewed_at")
  identityReviewedById String?        @map("identity_reviewed_by_id") @db.Uuid
  /// Active salon used by default at checkout.
  activeSalonId    String?            @map("active_salon_id") @db.Uuid
  /// Public handle chosen at registration (letters, numbers, underscores). Can also be used to sign in.
  username         String?            @unique
  /// Birthday without the year (optional), used only for birthday greetings when allowed.
  birthDay         Int?               @map("birth_day")
  birthMonth       Int?               @map("birth_month")
  /// Optional: birthday greetings and gifts. Separate from promotional marketing.
  birthdayGreetings Boolean           @default(false) @map("birthday_greetings")
  /// Optional: seasonal offers, samples and trade coupons.
  marketingOptIn   Boolean            @default(false) @map("marketing_opt_in")
  termsAcceptedAt  DateTime?          @map("terms_accepted_at")
  privacyAcceptedAt DateTime?         @map("privacy_accepted_at")
  /// Interface language for the customer screens.
  preferredLanguage AppLanguage       @default(en) @map("preferred_language")
  /// Optional shopping preference (R04).
  restockFrequency RestockFrequency?  @map("restock_frequency")
  /// Set when the customer finishes (or skips) the last registration step.
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user               User  @relation("CustomerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  identityReviewedBy User? @relation("IdentityReviewedBy", fields: [identityReviewedById], references: [id])

  @@map("customer_profiles")
}

/// Supported interface languages for customer screens.
enum AppLanguage {
  en
  si
}

enum RestockFrequency {
  WEEKLY
  EVERY_TWO_WEEKS
  MONTHLY
  EVERY_FEW_MONTHS
  WHEN_NEEDED
}

/// Shopping preferences (R04): product types the customer is interested in. Personalisation only.
model CustomerInterest {
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("customer_interests")
}

/// Shopping preferences (R04): brands the customer prefers. Personalisation only.
model CustomerPreferredBrand {
  userId    String   @map("user_id") @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@map("customer_preferred_brands")
}

/// "My Regular Products": specific products the customer expects to need regularly,
/// even if never bought. Separate from general interests.
model RegularProduct {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// The quantity the salon usually orders (sale units). Null = the product's minimum order.
  quantity  Int?
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("regular_products")
}

/// A salon premises owned by a customer. Each order is placed for one salon.
model Salon {
  id              String             @id @default(uuid()) @db.Uuid
  ownerId         String             @map("owner_id") @db.Uuid
  tradeName       String             @map("trade_name")
  branchTag       String?            @map("branch_tag")
  phone           String
  invoiceEmail    String?            @map("invoice_email")
  businessRegNo   String?            @map("business_reg_no")
  street          String
  city            String
  district        String
  province        String
  postalCode      String?            @map("postal_code")
  latitude        Decimal?           @db.Decimal(9, 6)
  longitude       Decimal?           @db.Decimal(9, 6)
  liftGateRequired Boolean           @default(false) @map("lift_gate_required")
  groundFloorBay  Boolean            @default(false) @map("ground_floor_bay")
  forkliftAccess  Boolean            @default(false) @map("forklift_access")
  status          VerificationStatus @default(NOT_SUBMITTED)
  submittedAt     DateTime?          @map("submitted_at")
  reviewedAt      DateTime?          @map("reviewed_at")
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  archivedAt      DateTime?          @map("archived_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  owner      User                   @relation("SalonOwner", fields: [ownerId], references: [id])
  reviewedBy User?                  @relation("SalonReviewedBy", fields: [reviewedById], references: [id])
  addresses  Address[]
  documents  VerificationDocument[]
  events     VerificationEvent[]

  @@index([ownerId])
  @@index([status])
  @@map("salons")
}

/// Delivery address. Orders copy the address into a snapshot, so editing/deleting never changes old orders.
model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  salonId       String?   @map("salon_id") @db.Uuid
  label         String
  recipientName String    @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  city          String
  district      String
  province      String
  postalCode    String?   @map("postal_code")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  driverNotes   String?   @map("driver_notes")
  isDefault     Boolean   @default(false) @map("is_default")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon  Salon?  @relation(fields: [salonId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

enum VerificationDocumentKind {
  NIC_FRONT
  NIC_BACK
  SELFIE
  SALON_PHOTO
  BUSINESS_DOCUMENT
  CLARIFICATION
}

/// A file in the private "verification-documents" bucket. Replaced files are kept (supersededAt) for audit.
model VerificationDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  salonId      String?                  @map("salon_id") @db.Uuid
  kind         VerificationDocumentKind
  storagePath  String                   @unique @map("storage_path")
  uploadedAt   DateTime                 @default(now()) @map("uploaded_at")
  supersededAt DateTime?                @map("superseded_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon Salon? @relation(fields: [salonId], references: [id])

  @@index([userId, kind])
  @@index([salonId])
  @@map("verification_documents")
}

enum VerificationEventType {
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
  CLARIFICATION_RESPONDED
}

/// Verification history and clarification messages between the customer and staff.
model VerificationEvent {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @map("customer_id") @db.Uuid
  salonId    String?               @map("salon_id") @db.Uuid
  actorId    String                @map("actor_id") @db.Uuid
  type       VerificationEventType
  message    String?
  createdAt  DateTime              @default(now()) @map("created_at")

  customer User   @relation("VerificationEventCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  actor    User   @relation("VerificationEventActor", fields: [actorId], references: [id])
  salon    Salon? @relation(fields: [salonId], references: [id])

  @@index([customerId, createdAt])
  @@index([salonId])
  @@map("verification_events")
}

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

/// Privacy requests (A12). Handled by staff; deletion anonymizes personal data but keeps business records.
model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  type        DataRequestType
  status      DataRequestStatus @default(REQUESTED)
  reason      String?
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_requests")
}

/// One-time SMS codes for phone verification. Only a hash of the code is stored.
model PhoneOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_otps")
}

// ---------------------------------------------------------------------------
// Shopping (Section B)
// ---------------------------------------------------------------------------

/// One open cart per customer. Prices are calculated live; orders take the price snapshot.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime       @default(now()) @map("added_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
